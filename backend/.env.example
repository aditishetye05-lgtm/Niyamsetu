# Backend Configuration
PROJECT_NAME="NiyamSetu API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database URL
# For local development without PostgreSQL, SQLite is supported as fallback:
DATABASE_URL=sqlite:///./niyamsetu.db

# For PostgreSQL / Supabase, uncomment and fill in:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
